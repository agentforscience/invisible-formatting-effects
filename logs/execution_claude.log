{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgWyf5BYzVhbrN13Y4JrQ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01GTVY4oPc4XTTD4SbkbZqnE","name":"Write","input":{"file_path":"/data/summereunann/neurico-workspaces/invisible_formatting_effects_20261029_120001_qr78st90/src/gen_server.py","content":"\"\"\"Generate with the host's long-lived vLLM server (Qwen3-8B, OpenAI-compatible, :8011), greedy, thinking off.\n\nUsage: python src/gen_server.py [N_THREADS]     -> results/gens/qwen3-8b.jsonl (resumable, append-only)\nUses only the standard library.\n\"\"\"\nimport json, os, random, sys, threading, time, urllib.request, fcntl\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parent.parent\nURL = \"http://127.0.0.1:8011/v1/chat/completions\"\nKEY, MODEL = \"qwen3-8b\", \"Qwen3-8B\"\nOUT = ROOT / \"results/gens\" / f\"{KEY}.jsonl\"\nSEED = 42\n\n\ndef call(p):\n    body = dict(model=MODEL, messages=[{\"role\": \"user\", \"content\": p[\"prompt\"]}], temperature=0.0, seed=SEED,\n                max_tokens=12 if p[\"kind\"] == \"cls\" else 512, chat_template_kwargs={\"enable_thinking\": False})\n    for attempt in range(6):\n        try:\n            req = urllib.request.Request(URL, data=json.dumps(body).encode(), headers={\"Content-Type\": \"application/json\"})\n            r = json.load(urllib.request.urlopen(req, timeout=600))\n            c = r[\"choices\"][0]\n            return dict(pid=p[\"pid\"], text=c[\"message\"][\"content\"], finish=c[\"finish_reason\"],\n                        n_prompt=r[\"usage\"][\"prompt_tokens\"], n_out=r[\"usage\"][\"completion_tokens\"], ids_hash=None)\n        except Exception as e:\n            time.sleep(2 ** attempt)\n            err = e\n    print(\"FAILED\", p[\"pid\"], err, flush=True)\n    return None\n\n\ndef main():\n    n_threads = int(sys.argv[1]) if len(sys.argv) > 1 else 48\n    OUT.parent.mkdir(parents=True, exist_ok=True)\n    lock = open(OUT.with_suffix(\".lock\"), \"w\")\n    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)\n    prompts = [json.loads(l) for l in open(ROOT / \"data/prompts.jsonl\")]\n    done = {json.loads(l)[\"pid\"] for l in open(OUT)} if OUT.exists() else set()\n    todo = [p for p in prompts if p[\"pid\"] not in done]\n    random.Random(SEED).shuffle(todo)\n    todo.sort(key=lambda p: p[\"kind\"] != \"cls\")       # short classification prompts first\n    print(f\"{len(done)} done, {len(todo)} to do\", flush=True)\n    wl, t0, n = threading.Lock(), time.time(), 0\n    with open(OUT, \"a\") as f, ThreadPoolExecutor(n_threads) as ex:\n        for res in ex.map(call, todo):\n            if res is None:\n                continue\n            with wl:\n                f.write(json.dumps(res, ensure_ascii=False) + \"\\n\"); f.flush()\n            n += 1\n            if n % 500 == 0:\n                print(f\"{n}/{len(todo)} {time.time() - t0:.0f}s\", flush=True)\n    print(\"DONE\", flush=True)\n\n\nif __name__ == \"__main__\":\n    main()\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1502,"cache_read_input_tokens":92819,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1502},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ca68dff7-3fed-493e-b883-6ab7358c4498","uuid":"b8334e27-856a-48bf-8948-b174ed8a22a4","timestamp":"2026-10-29T18:10:18.125Z","request_id":"req_011CgWyf4wR53UMbTm1vpnFc","wire_tool_inputs":{"toolu_01GTVY4oPc4XTTD4SbkbZqnE":{"file_path":"/data/summereunann/neurico-workspaces/invisible_formatting_effects_20261029_120001_qr78st90/src/gen_server.py","content":"\"\"\"Generate with the host's long-lived vLLM server (Qwen3-8B, OpenAI-compatible, :8011), greedy, thinking off.\n\nUsage: python src/gen_server.py [N_THREADS]     -> results/gens/qwen3-8b.jsonl (resumable, append-only)\nUses only the standard library.\n\"\"\"\nimport json, os, random, sys, threading, time, urllib.request, fcntl\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parent.parent\nURL = \"http://127.0.0.1:8011/v1/chat/completions\"\nKEY, MODEL = \"qwen3-8b\", \"Qwen3-8B\"\nOUT = ROOT / \"results/gens\" / f\"{KEY}.jsonl\"\nSEED = 42\n\n\ndef call(p):\n    body = dict(model=MODEL, messages=[{\"role\": \"user\", \"content\": p[\"prompt\"]}], temperature=0.0, seed=SEED,\n                max_tokens=12 if p[\"kind\"] == \"cls\" else 512, chat_template_kwargs={\"enable_thinking\": False})\n    for attempt in range(6):\n        try:\n            req = urllib.request.Request(URL, data=json.dumps(body).encode(), headers={\"Content-Type\": \"application/json\"})\n            r = json.load(urllib.request.urlopen(req, timeout=600))\n            c = r[\"choices\"][0]\n            return dict(pid=p[\"pid\"], text=c[\"message\"][\"content\"], finish=c[\"finish_reason\"],\n                        n_prompt=r[\"usage\"][\"prompt_tokens\"], n_out=r[\"usage\"][\"completion_tokens\"], ids_hash=None)\n        except Exception as e:\n            time.sleep(2 ** attempt)\n            err = e\n    print(\"FAILED\", p[\"pid\"], err, flush=True)\n    return None\n\n\ndef main():\n    n_threads = int(sys.argv[1]) if len(sys.argv) > 1 else 48\n    OUT.parent.mkdir(parents=True, exist_ok=True)\n    lock = open(OUT.with_suffix(\".lock\"), \"w\")\n    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)\n    prompts = [json.loads(l) for l in open(ROOT / \"data/prompts.jsonl\")]\n    done = {json.loads(l)[\"pid\"] for l in open(OUT)} if OUT.exists() else set()\n    todo = [p for p in prompts if p[\"pid\"] not in done]\n    random.Random(SEED).shuffle(todo)\n    todo.sort(key=lambda p: p[\"kind\"] != \"cls\")       # short classification prompts first\n    print(f\"{len(done)} done, {len(todo)} to do\", flush=True)\n    wl, t0, n = threading.Lock(), time.time(), 0\n    with open(OUT, \"a\") as f, ThreadPoolExecutor(n_threads) as ex:\n        for res in ex.map(call, todo):\n            if res is None:\n                continue\n            with wl:\n                f.write(json.dumps(res, ensure_ascii=False) + \"\\n\"); f.flush()\n            n += 1\n            if n % 500 == 0:\n                print(f\"{n}/{len(todo)} {time.time() - t0:.0f}s\", flush=True)\n    print(\"DONE\", flush=True)\n\n\nif __name__ == \"__main__\":\n    main()\n"}}}
