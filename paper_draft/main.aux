\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Divergence (\%) per edit, pooled over 11 models. $\Delta $tok\xspace  is the mean number of prompt token positions changed after the chat template and tokenizer. The most disruptive edit in each column is in bold. $^*$\texttt  {ellipsis_char} applies to only 40 classification and 9 code items per model, so its CIs are very wide.\relax }}{6}{table.caption.5}\protected@file@percent }
\newlabel{tab:per_condition}{{3}{6}{Divergence (\%) per edit, pooled over 11 models. \dtok is the mean number of prompt token positions changed after the chat template and tokenizer. The most disruptive edit in each column is in bold. $^*$\cond {ellipsis_char} applies to only 40 classification and 9 code items per model, so its CIs are very wide.\relax }{table.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Classification label-flip rate (\%) per model and edit. Llama-3.2-1B under \texttt  {nbsp} reaches 39\%, and \textsc  {Qwen2.5}\xspace  -0.5B under a single trailing \texttt  {\textbackslash n\textbackslash n} reaches 18\%. The Llama \texttt  {trailing_newlines} column is exactly 0 because Llama chat templates strip trailing whitespace, so the model never sees the edit (a placebo). Punctuation columns stay below 1\% for $\geq $7B models.\relax }}{6}{figure.caption.6}\protected@file@percent }
\newlabel{fig:heat}{{2}{6}{Classification label-flip rate (\%) per model and edit. Llama-3.2-1B under \cond {nbsp} reaches 39\%, and \qwentwo -0.5B under a single trailing \texttt {\textbackslash n\textbackslash n} reaches 18\%. The Llama \cond {trailing_newlines} column is exactly 0 because Llama chat templates strip trailing whitespace, so the model never sees the edit (a placebo). Punctuation columns stay below 1\% for $\geq $7B models.\relax }{figure.caption.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Divergence (\%) per model. The horizontal rule separates small ($<$3B) from large ($\geq $3B) models. The highest value in each perturbation column is in bold. Whitespace exceeds punctuation for every model. Small models dominate classification flips, while code text changes show no size trend. Control columns show batch-position noise, which is negligible for labels but reaches 21\% of code outputs for \textsc  {Qwen3}\xspace  -0.6B.\relax }}{7}{table.caption.7}\protected@file@percent }
\newlabel{tab:per_model}{{4}{7}{Divergence (\%) per model. The horizontal rule separates small ($<$3B) from large ($\geq $3B) models. The highest value in each perturbation column is in bold. Whitespace exceeds punctuation for every model. Small models dominate classification flips, while code text changes show no size trend. Control columns show batch-position noise, which is negligible for labels but reaches 21\% of code outputs for \qwenthree -0.6B.\relax }{table.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Effect of model size (\%). Ratios use a paired bootstrap over items with 95\% CIs. Small models are 2--3$\times $ more label-sensitive (bold), but they are not more sensitive on code. The \textsc  {Qwen2.5}\xspace  -only row compares 0.5B/1.5B with 3B/7B/14B.\relax }}{7}{table.caption.8}\protected@file@percent }
\newlabel{tab:size}{{5}{7}{Effect of model size (\%). Ratios use a paired bootstrap over items with 95\% CIs. Small models are 2--3$\times $ more label-sensitive (bold), but they are not more sensitive on code. The \qwentwo -only row compares 0.5B/1.5B with 3B/7B/14B.\relax }{table.caption.8}{}}
