\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Divergence from the canonical output (\%), averaged over items, models and conditions, with bootstrap 95\% CIs over items. Every edit family is far above the identical-prompt control, and whitespace (bold) exceeds punctuation on every metric. For classification flips, the punctuation $-$ whitespace difference is $-4.9$\,pp\xspace  {\relax \fontsize  {7}{8}\selectfont  [$-5.2$, $-4.6$]}.\relax }}{5}{table.caption.3}\protected@file@percent }
\newlabel{tab:overall}{{2}{5}{Divergence from the canonical output (\%), averaged over items, models and conditions, with bootstrap 95\% CIs over items. Every edit family is far above the identical-prompt control, and whitespace (bold) exceeds punctuation on every metric. For classification flips, the punctuation $-$ whitespace difference is $-4.9$\pp \ci {$-5.2$}{$-4.6$}.\relax }{table.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Divergence per edit, pooled over 11 models, with bootstrap 95\% CIs. {\em  (Left)}classification label flips. {\em  (Center)}code text changes. {\em  (Right)}code pass/fail flips. Blue bars are whitespace edits, orange bars punctuation edits, and grey is the identical-prompt control. Labels above the bars give $\Delta $tok\xspace  , the mean number of changed prompt tokens. Every whitespace edit except \texttt  {trailing_newlines} exceeds every punctuation edit on label and pass/fail flips.\relax }}{5}{figure.caption.4}\protected@file@percent }
\newlabel{fig:per_condition}{{1}{5}{Divergence per edit, pooled over 11 models, with bootstrap 95\% CIs. \figleft classification label flips. \figcenter code text changes. \figright code pass/fail flips. Blue bars are whitespace edits, orange bars punctuation edits, and grey is the identical-prompt control. Labels above the bars give \dtok , the mean number of changed prompt tokens. Every whitespace edit except \cond {trailing_newlines} exceeds every punctuation edit on label and pass/fail flips.\relax }{figure.caption.4}{}}
